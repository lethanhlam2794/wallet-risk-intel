# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://wallet:devonly@127.0.0.1:5433/check_wallet?sslmode=disable
TEST_DATABASE_URL=postgres://wallet:devonly@127.0.0.1:5433/check_wallet_test?sslmode=disable
REDIS_URL=redis://127.0.0.1:6380/0
TEST_REDIS_URL=redis://127.0.0.1:6380/9
HTTP_ADDR=:8080
LOG_LEVEL=info

# Dev-only API key bootstrap (upserted at api start; see README).
API_BOOTSTRAP_ADMIN_KEY=dev-admin-key-change-me
API_BOOTSTRAP_READER_KEY=dev-reader-key-change-me

# Optional tuning (all values shown = code defaults)
SANCTIONS_STALE_AFTER=48h
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_ANON=30
OFAC_SNAPSHOT_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN_ADVANCED.XML
OFAC_DOWNLOAD_MAX_BYTES=536870912
OFAC_DOWNLOAD_TIMEOUT=10m

# Live enrichment providers (phase 4). Base URLs must stay inside each
# adapter's hardcoded host allowlist — overrides exist for tests/dev only.
GOPLUS_BASE_URL=https://api.gopluslabs.io
# gopluslabs.io — optional; raises quota
GOPLUS_API_KEY=
GOPLUS_RATE_PER_MIN=30
PUBLICAML_BASE_URL=https://intelapi.publicaml.org
# intelapi.publicaml.org — optional; raises limit
PUBLICAML_API_KEY=
PUBLICAML_RATE_PER_MIN=15
CHAINABUSE_BASE_URL=https://api.chainabuse.com
# api.chainabuse.com — REQUIRED to enable chainabuse (disabled without it)
CHAINABUSE_API_KEY=
CHAINABUSE_RATE_PER_MIN=1

# Transaction providers (Phase 6) — free tiers, both REQUIRED for
# live indexing; adapters report "disabled" without keys.
# etherscan.io account — ethereum tx history
ETHERSCAN_API_KEY=
# nodereal.io MegaNode — bsc tx history
NODEREAL_API_KEY=
TXINDEX_MAX_PAGES_HOP0=5
TXINDEX_MAX_PAGES_HOPN=2
TXINDEX_BUDGET_ETH=32
TXINDEX_BUDGET_BSC=8

# Enrichment cache & tracing tuning (values = code defaults)
ENRICHMENT_CACHE_TTL=15m
ENRICHMENT_NEGATIVE_TTL=60s
ENRICHMENT_REFRESH_COOLDOWN=60s
ENRICHMENT_DEADLINE=25s

# Phase 7 advanced tracing (per-depth frontier caps; legacy
# TRACING_MAX_NODES remains the depth-2 fallback)
TRACING_MAX_NODES_2=50
TRACING_MAX_NODES_3=25
TRACING_MAX_NODES_4=12
TRACING_MAX_NODES_5=6
TXINDEX_MAX_PAGES_HOP3=1

# ────────────────────────────────────────────────────────────────────
# NEW — Transaction-history provider expansion (10 adapters + failover)
# ────────────────────────────────────────────────────────────────────
# Per-network adapter selection. Values shown = the defaults.
# Comma list = ordered failover chain (fails over on
# rate_limited/5xx/degraded/transport/circuit_open; never on empty
# page, 4xx, malformed, timeout, internal, disabled); unknown or empty
# entries fail boot.
TX_PROVIDER_ETH=chainscan
TX_PROVIDER_BSC=nodereal
#
# Expansion adapters — all optional; a missing key ⇒ Enabled()=false
# (honest DISABLED, never failure). Unverified keyed adapters stay out
# of defaults until live-verified.
# alchemy.com — eth+bsc tx history
ALCHEMY_API_KEY=
# empty → eth-mainnet/bnb-mainnet per network
ALCHEMY_BASE_URL=
ALCHEMY_ENABLED_CHAINS=ethereum,bsc
TXINDEX_BUDGET_ALCHEMY=8
# keyless; ethereum only
BLOCKSCOUT_BASE_URL=https://eth.blockscout.com
BLOCKSCOUT_ENABLED_CHAINS=ethereum
TXINDEX_BUDGET_BLOCKSCOUT=8
# ankr.com Advanced API — eth+bsc
ANKR_API_KEY=
ANKR_BASE_URL=https://rpc.ankr.com/multichain
ANKR_ENABLED_CHAINS=ethereum,bsc
TXINDEX_BUDGET_ANKR=8
# goldrush.dev — bsc only
COVALENT_API_KEY=
COVALENT_BASE_URL=https://api.covalenthq.com
COVALENT_ENABLED_CHAINS=bsc
TXINDEX_BUDGET_COVALENT=8
# moralis.io — bsc only
MORALIS_API_KEY=
MORALIS_BASE_URL=https://deep-index.moralis.io
MORALIS_ENABLED_CHAINS=bsc
TXINDEX_BUDGET_MORALIS=8
# tatum.io — bsc only; Data API v4 history
TATUM_API_KEY=
TATUM_BASE_URL=https://api.tatum.io
TATUM_ENABLED_CHAINS=bsc
TXINDEX_BUDGET_TATUM=8
# bitquery.io v2 — bsc only; Bearer ory_at_*
BITQUERY_API_KEY=
BITQUERY_BASE_URL=https://streaming.bitquery.io
BITQUERY_ENABLED_CHAINS=bsc
TXINDEX_BUDGET_BITQUERY=8
# oklink.com explorer — bsc only
OKLINK_API_KEY=
OKLINK_BASE_URL=https://www.oklink.com
OKLINK_ENABLED_CHAINS=bsc
TXINDEX_BUDGET_OKLINK=8
# tokenview.io vipapi — eth + bsc; drain/buffer, 2500-row reachable cap
TOKENVIEW_API_KEY=
TOKENVIEW_BASE_URL=https://services.tokenview.io
TOKENVIEW_ENABLED_CHAINS=ethereum,bsc
TXINDEX_BUDGET_TOKENVIEW=8
# chainbase.online Web3 API — eth + bsc
CHAINBASE_API_KEY=
CHAINBASE_BASE_URL=https://api.chainbase.online
CHAINBASE_ENABLED_CHAINS=ethereum,bsc
TXINDEX_BUDGET_CHAINBASE=8

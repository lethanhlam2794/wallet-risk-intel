prefix_rule(pattern=["/bin/bash", "-lc", "task_admin_pass=$(sed -nE 's/.*--admin-password[= ]([^ ;]+).*/\\1/p' pwd.yml | head -1); TASK_ADMIN_PASS=\"$task_admin_pass\" node -e 'const sleep=ms=>new Promise(r=>setTimeout(r,ms)); (async()=>{const targets=await (await fetch(\"http://127.0.0.1:9223/json\")).json(); const ws=new WebSocket(targets[0].webSocketDebuggerUrl); let id=0; const pending=new Map(); const errors=[]; ws.onmessage=e=>{const m=JSON.parse(e.data); if(m.id&&pending.has(m.id)){pending.get(m.id)(m);pending.delete(m.id)} if(m.method===\"Runtime.exceptionThrown\") errors.push(m.params.exceptionDetails.text); if(m.method===\"Log.entryAdded\"&&m.params.entry.level===\"error\") errors.push(m.params.entry.text)}; await new Promise(r=>ws.onopen=r); const call=(method,params={})=>new Promise(r=>{const n=++id;pending.set(n,r);ws.send(JSON.stringify({id:n,method,params}))}); await call(\"Runtime.enable\"); await call(\"Log.enable\"); await call(\"Page.enable\"); await call(\"Page.navigate\",{url:\"http://127.0.0.1:8080/login\"}); await sleep(3000); const pwd=JSON.stringify(process.env.TASK_ADMIN_PASS); await call(\"Runtime.evaluate\",{expression:`document.querySelector(\"#login_email\").value=\"Administrator\";document.querySelector(\"#login_password\").value=${pwd};document.querySelector(\"form.form-login\").dispatchEvent(new Event(\"submit\",{bubbles:true,cancelable:true}));`}); await sleep(5000); await call(\"Page.navigate\",{url:\"http://127.0.0.1:8080/desk/setup-wizard/0\"}); await sleep(10000); const out=await call(\"Runtime.evaluate\",{expression:`JSON.stringify({url:location.href,title:document.title,text:document.body.innerText.slice(0,2500),ready:document.readyState})`,returnByValue:true}); console.log(JSON.stringify({page:JSON.parse(out.result.result.value),errors},null,2)); ws.close();})().catch(e=>{console.error(e);process.exit(1)})'"], decision="allow")

prefix_rule(pattern=["node", "-e", "const {chromium}=require('playwright');(async()=>{const b=await chromium.launch({headless:true});const c=await b.newContext({viewport:{width:3742,height:1714},deviceScaleFactor:0.5});const p=await c.newPage();await p.goto('http://127.0.0.1:3100/vi',{waitUntil:'domcontentloaded',timeout:20000});const easy=p.getByRole('region',{name:'Tìm nguồn hàng dễ dàng'});await p.waitForTimeout(4000);const top=await easy.evaluate(e=>e.offsetTop);await p.evaluate(y=>scrollTo(0,y-24),top);await p.screenshot({path:'/tmp/viet-agri-lower-refactor-png.png'});const box=async l=>await l.boundingBox();const failed=await p.locator('img').evaluateAll(imgs=>imgs.filter(i=>!i.complete||i.naturalWidth===0).map(i=>({alt:i.alt,src:i.currentSrc||i.src})));const metrics={viewport:await p.evaluate(()=>({w:innerWidth,h:innerHeight,scrollY})),easy:await box(easy),secured:await box(p.getByRole('region',{name:'Dịch vụ giao dịch an toàn'})),solutions:await box(p.getByRole('region',{name:'Giải pháp tìm nguồn hàng & dịch vụ theo yêu cầu'})),trade:await box(p.getByRole('region',{name:'Triển lãm thương mại'})),hot:await box(p.getByRole('region',{name:'Thể loại nổi bật'})),overflow:await p.evaluate(()=>document.documentElement.scrollWidth-document.documentElement.clientWidth),failedImages:failed.length};await p.goto('http://127.0.0.1:3100/en',{waitUntil:'domcontentloaded',timeout:20000});const en={easy:await p.getByRole('heading',{name:'Easy Sourcing'}).count(),solutions:await p.getByRole('heading',{name:'Sourcing Solutions & Tailored Services'}).count(),trade:await p.getByRole('heading',{name:'Trade Shows'}).count(),hot:await p.getByRole('heading',{name:'Hot items'}).count()};console.log(JSON.stringify({metrics,en,failed:failed.slice(0,3)},null,2));await b.close()})().catch(e=>{console.error(e);process.exit(1)})"], decision="allow")
prefix_rule(pattern=["node", "-e", "const {chromium}=require('playwright');(async()=>{const b=await chromium.launch({headless:true});const c=await b.newContext({viewport:{width:3742,height:1714},deviceScaleFactor:0.5});const p=await c.newPage();await p.goto('http://127.0.0.1:3100/vi',{waitUntil:'domcontentloaded',timeout:15000});const easy=p.getByRole('region',{name:'Tìm nguồn hàng dễ dàng'});const top=await easy.evaluate(e=>e.getBoundingClientRect().top+scrollY);await p.evaluate(y=>scrollTo(0,y-24),top);await p.waitForTimeout(8000);await p.screenshot({path:'/tmp/viet-agri-lower-final.png'});const failed=await easy.locator('img').evaluateAll(imgs=>imgs.filter(i=>!i.complete||i.naturalWidth===0).map(i=>i.alt));const allPlaceholderFailed=await p.locator('img[src*=\\\"placehold\\\"]').evaluateAll(imgs=>imgs.filter(i=>!i.complete||i.naturalWidth===0).length);console.log(JSON.stringify({top,scrollY:await p.evaluate(()=>scrollY),failedEasy:failed,placeholderFailed:allPlaceholderFailed,overflow:await p.evaluate(()=>document.documentElement.scrollWidth-document.documentElement.clientWidth)}));await b.close()})().catch(e=>{console.error(String(e));process.exit(1)})"], decision="allow")

prefix_rule(pattern=["node", "-e", "const fs=require('fs');const cp=require('child_process');const path='apps/zenith-landing-page/src/i18n/ui.ts';const main=cp.execFileSync('git',['show','origin/main:'+path],{encoding:'utf8'});const branch=cp.execFileSync('git',['show','ORIG_HEAD:'+path],{encoding:'utf8'});const locs=['en','vi','zh','pt','fr','ru'];function findBlock(s,loc){const marker='const '+loc+': Dictionary = {';const start=s.indexOf(marker);if(start<0)throw new Error('missing '+loc);const open=s.indexOf('{',start);let depth=0,str=false,esc=false;for(let i=open;i<s.length;i++){const c=s[i];if(str){if(esc)esc=false;else if(c==='\\\\\\\\')esc=true;else if(c==='\\\"')str=false;continue;}if(c==='\\\"'){str=true;continue;}if(c==='{')depth++;else if(c==='}'){depth--;if(depth===0)return {start,open,end:i,body:s.slice(open+1,i)};}}throw new Error('unclosed '+loc);}function entries(body){const out=[];let start=0,str=false,esc=false,paren=0,brack=0,brace=0;for(let i=0;i<body.length;i++){const c=body[i];if(str){if(esc)esc=false;else if(c==='\\\\\\\\')esc=true;else if(c==='\\\"')str=false;continue;}if(c==='\\\"'){str=true;continue;}if(c==='(')paren++;else if(c===')')paren--;else if(c==='[')brack++;else if(c===']')brack--;else if(c==='{')brace++;else if(c==='}')brace--;else if(c===','&&paren===0&&brack===0&&brace===0){const raw=body.slice(start,i).trimEnd();const m=raw.match(/^\\s*\\\"([^\\\"]+)\\\"\\s*:/);if(m)out.push([m[1],raw]);start=i+1;}}const raw=body.slice(start).trimEnd();const m=raw.match(/^\\s*\\\"([^\\\"]+)\\\"\\s*:/);if(m)out.push([m[1],raw]);return out;}let merged=main;for(const loc of locs){const mb=findBlock(merged,loc);const bb=findBlock(branch,loc);const have=new Set(entries(mb.body).map(([k])=>k));const missing=entries(bb.body).filter(([k])=>!have.has(k)).map(([,raw])=>raw.trimEnd());if(!missing.length)continue;const insert='\\n'+missing.map(e=>'  '+e.trimStart()+',').join('\\n')+'\\n';merged=merged.slice(0,mb.end)+insert+merged.slice(mb.end);}fs.writeFileSync(path,merged);"], decision="allow")
